PORT=3000
HOST=127.0.0.1
JWT_SECRET=replace-with-a-long-random-secret
# Private cloud PostgreSQL. Never commit .env or real records.
DATABASE_URL=postgresql://user:password@host:5432/database
DB_SSL_VERIFY=true
# For an isolated local database instead, set DB_CLIENT=sqlite.
# DB_CLIENT=sqlite
# DB_FILE=tracker.local.db
# Local PostgreSQL may need DB_SSL=false.
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
NEWS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Only enable with a NewsAPI plan that permits production usage.
NEWS_API_PRODUCTION_ALLOWED=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Render: NODE_ENV=production, HOST=0.0.0.0, TRUST_PROXY=1.
# Keep the existing DATABASE_URL and API keys in Render, never in GitHub.
ENABLE_LEGACY_ROUTES=false
# Automatic full application backups need a private persistent disk.
AUTO_BACKUP=false
BACKUP_DIR=
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=30
# Attempted provider requests are shared across quotes and research.
TWELVE_MINUTE_LIMIT=6
TWELVE_DAILY_LIMIT=600
FINNHUB_MINUTE_LIMIT=30
FINNHUB_DAILY_LIMIT=1000
NEWS_DAILY_LIMIT=50
GEMINI_DAILY_LIMIT=10
