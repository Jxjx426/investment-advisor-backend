PORT=3000
HOST=127.0.0.1
JWT_SECRET=replace-with-a-long-random-secret
# Private cloud PostgreSQL. Never commit .env or real records.
DATABASE_URL=postgresql://user:password@host:5432/database
DB_SSL_VERIFY=true
# For an isolated local database instead, set DB_CLIENT=sqlite.
# DB_CLIENT=sqlite
# DB_FILE=tracker.local.db
# Local PostgreSQL may need DB_SSL=false.
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
